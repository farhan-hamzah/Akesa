# Copy this file to .env and fill in real values. Never commit .env.

APP_ENV=development
PORT=8080

# Local Postgres (matches docker-compose.yml defaults)
DATABASE_URL=

# From your Clerk dashboard -> API Keys -> Secret key
CLERK_SECRET_KEY=

# --- Sensitive-field protection (NIK, insurance number) ---
# These three keys are what keep NIK safe both in Postgres and in the
# audit hash chain. Each one needs to be different, and each developer
# should generate their own for local dev - never reuse a key from another
# environment, and never commit real values.

# AES-256 key for encrypting NIK / insurance number at rest.
# MUST be base64 of exactly 32 raw bytes. Generate with:
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# HMAC key used only for the NIK uniqueness/lookup hash stored in Postgres.
# Any random string, at least 16 characters. Generate with:
#   openssl rand -hex 32
NIK_HASH_KEY=

# HMAC key used only for the profile hash written into the audit chain.
# Must be different from NIK_HASH_KEY. Generate with:
#   openssl rand -hex 32
AUDIT_HASH_KEY=
